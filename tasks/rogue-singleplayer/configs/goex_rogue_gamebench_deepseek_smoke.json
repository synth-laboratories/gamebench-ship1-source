{
  "run": {
    "run_id": "rogue_goex_gamebench_deepseek_smoke",
    "output_dir": "reports/goex_runs"
  },
  "container": {
    "url": "http://127.0.0.1:8102",
    "startup_timeout_seconds": 30
  },
  "taskset": {
    "train_seeds": [1, 2, 3, 4],
    "heldout_seeds": [11, 12],
    "profile": "rogue_singleplayer_agent",
    "reward_mode": "goal_binary",
    "env_config": {
      "task_path": "tasks/policy_dev_template.json",
      "max_steps": 40
    },
    "context": {
      "task_family": "rogue-singleplayer",
      "checkpoint_restore_semantics": "true_environment_snapshot",
      "allow_request_snapshot_resume": false,
      "require_real_rewards": true,
      "required_candidate_kind": "prompt",
      "prompt_only_candidate_authoring": true,
      "forbid_code_policy_candidates": true,
      "target_objective_label": "descend",
      "prototype_only": true
    }
  },
  "policy": {
    "model": "deepseek-v4-flash",
    "provider": "deepseek",
    "api_key_env": "DEEPSEEK_API_KEY",
    "inference_url": "https://api.deepseek.com/chat/completions",
    "max_tokens": 512,
    "config": {
      "use_lm": true,
      "policy_id": "react_deepseek_v1",
      "temperature": 0.0,
      "max_llm_turns": 20
    }
  },
  "go_ex": {
    "max_rollouts": 40,
    "proposer_rounds": 1,
    "base_react_system_prompt": "You are a Rogue ReAct policy on GameBench rust gold. Explore the dungeon, collect useful items, reach stairs (%), then descend with >. Reply with JSON only, for example {\"action\":\"l\"}.",
    "segment_steps": 40,
    "resume_segment_steps": 24,
    "candidates_per_proposer": 2,
    "heldout_measurement_rollouts": 2,
    "holdout_consolidate_k": 2,
    "bootstrap_train_rollout_count": 2,
    "reserved_search_rollout_budget": 2,
    "target_new_candidate_count": 2,
    "auto_consolidate_min_mature_themes": 2,
    "auto_consolidate_theme_count": 2,
    "auto_consolidate_min_score": 0.0,
    "max_llm_turns": 20,
    "max_actions_per_turn": 1,
    "submission_mode": "async",
    "execute_live_proposers": true,
    "request_timeout_seconds": 180.0,
    "container_connect_timeout_seconds": 30.0,
    "allow_resume_fallback_to_fresh": false,
    "rollout_state_poll_seconds": 0.5,
    "rollout_terminator_poll_seconds": 0.5,
    "rollout_stall_timeout_seconds": 240.0,
    "full_rollout_lane_enabled": true,
    "full_rollout_budget_per_round": 0,
    "full_rollout_initial_budget": 6,
    "full_rollout_cadence": 1,
    "preserve_search_measurement_split": true,
    "theme_start_score_band": [0.0, 0.9],
    "frontier_prune_enabled": true,
    "frontier_prune_soft_cap": 120,
    "frontier_prune_retain_tail": 40,
    "frontier_prune_hard_delete": false,
    "fresh_rollouts_per_parent": 0,
    "resume_rollouts_per_parent": 1,
    "full_rollout_concurrency": 4,
    "theme_rollout_concurrency": 4,
    "closeout_heldout_concurrency": 4,
    "closeout_heldout_candidate_parallelism": 2,
    "heldout_measurement_concurrency": 4,
    "heldout_measurement_candidate_parallelism": 2,
    "full_rollout_checkpoint_cadence": "per_llm_call",
    "full_rollout_checkpoint_budget": 320,
    "data_miner_min_new_checkpoints": 1,
    "data_miner_rollouts_per_job": 2,
    "agent_dispatch_concurrency": 2,
    "agent_model_concurrency": {
      "deepseek-v4-flash": 4
    },
    "data_miner_cadence": "after_full_rollout_phase",
    "theme_finalize_min_checkpoints": 2,
    "theme_partials_per_candidate": 1,
    "theme_saturation_threshold": 0.9,
    "theme_saturation_min_rollouts": 2,
    "max_tentative_themes": 2,
    "tentative_theme_max_age_rounds": 1,
    "theme_proposal_round_budget": 1,
    "theme_aux_budget_per_theme": 1,
    "theme_no_progress_rounds": 1,
    "theme_aux_rounds_per_staircase": 1,
    "terminator_default": "agent",
    "promotion_min_seeds": 2,
    "promotion_margin": 0.05,
    "consolidation_budget_per_round": 1,
    "consolidation_max_themes": 2,
    "allow_single_theme_consolidation": false,
    "min_tentative_themes_before_activation": 1,
    "data_miner_while_active_theme_climbing": true,
    "data_miner_authority": false,
    "all_candidate_holdout_seed_count": 2,
    "auto_aux_hill_climb_calls_per_round": 1,
    "theme_eval_checkpoints": 0
  },
  "seed_candidate": {
    "react_system_prompt": "You are a Rogue ReAct policy on GameBench rust gold. Explore the dungeon, collect useful items, reach stairs (%), then descend with >. Reply with JSON only, for example {\"action\":\"l\"}."
  },
  "proposers": {
    "core_proposer": {
      "model": "deepseek-v4-flash",
      "provider": "deepseek",
      "role": "core_proposer",
      "output_schema": "goex.core_proposer.output.v1",
      "backend": "deepseek_chat",
      "auth_mode": "api_key",
      "timeout_seconds": 300,
      "reasoning_effort": "high",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "aux_hill_climb_proposer": {
      "model": "deepseek-v4-flash",
      "provider": "deepseek",
      "role": "aux_hill_climb_proposer",
      "output_schema": "goex.aux_hill_climb.output.v1",
      "backend": "deepseek_chat",
      "auth_mode": "api_key",
      "timeout_seconds": 300,
      "reasoning_effort": "high",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "aux_data_miner_proposer": {
      "model": "deepseek-v4-flash",
      "provider": "deepseek",
      "role": "aux_data_miner_proposer",
      "output_schema": "goex.aux_data_miner.v1",
      "backend": "deepseek_chat",
      "auth_mode": "api_key",
      "timeout_seconds": 300,
      "reasoning_effort": "high",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "aux_consolidate_proposer": {
      "model": "deepseek-v4-flash",
      "provider": "deepseek",
      "role": "aux_consolidate_proposer",
      "output_schema": "goex.aux_consolidate.output.v1",
      "backend": "deepseek_chat",
      "auth_mode": "api_key",
      "timeout_seconds": 300,
      "reasoning_effort": "high",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "aux_consolidate_hill_climb_proposer": {
      "model": "deepseek-v4-flash",
      "provider": "deepseek",
      "role": "aux_consolidate_hill_climb_proposer",
      "output_schema": "goex.aux_consolidate_hill_climb.output.v1",
      "backend": "deepseek_chat",
      "auth_mode": "api_key",
      "timeout_seconds": 300,
      "reasoning_effort": "high",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY"
    }
  },
  "cache": {
    "mode": "off"
  },
  "disk_budget": {
    "enabled": true,
    "soft_limit_gb": 5.0,
    "hard_limit_gb": 10.0
  },
  "plugins": {
    "enabled": ["prompt"]
  }
}
