 #include "hack.h"
 
+#include <stdint.h>
+
+/* TRACE-ONLY SOURCE EVIDENCE.  This ledger is bounded, read-only from the
+ * game perspective, and never consulted by NetHack.  It records the object
+ * and pet call ownership needed to join dog_move's RNG chronology. */
+#define NLE_DOG_TRACE_CAPACITY 131072U
+struct nle_dog_trace_event {
+    uint32_t kind; /* 1..5=dog/object calls, 6=rndmonst, 7=newmonhp */
+    uint32_t entity_id;
+    uint32_t object_id;
+    int32_t object_type;
+    int32_t object_where;
+    int64_t object_quantity;
+    int32_t native_x;
+    int32_t native_y;
+    int32_t arg0;
+    int32_t arg1;
+    int32_t arg2;
+    int32_t result;
+    int64_t moves;
+    int64_t monstermoves;
+    int32_t hero_native_x;
+    int32_t hero_native_y;
+};
+static struct nle_dog_trace_event nle_dog_trace_events[NLE_DOG_TRACE_CAPACITY];
+static uint32_t nle_dog_trace_count_;
+static boolean nle_dog_trace_overflow_;
+
+void
+nle_dog_trace_reset(void)
+{
+    nle_dog_trace_count_ = 0;
+    nle_dog_trace_overflow_ = FALSE;
+}
+
+uint32_t
+nle_dog_trace_count(void)
+{
+    return nle_dog_trace_count_;
+}
+
+boolean
+nle_dog_trace_overflow(void)
+{
+    return nle_dog_trace_overflow_;
+}
+
+boolean
+nle_dog_trace_get(uint32_t index, struct nle_dog_trace_event *out)
+{
+    if (index >= nle_dog_trace_count_ || !out)
+        return FALSE;
+    *out = nle_dog_trace_events[index];
+    return TRUE;
+}
+
+void
+nle_dog_trace_record(unsigned kind, struct monst *mon, struct obj *obj,
+                     int arg0, int arg1, int arg2, int result)
+{
+    struct nle_dog_trace_event *event;
+    if (nle_dog_trace_count_ >= NLE_DOG_TRACE_CAPACITY) {
+        nle_dog_trace_overflow_ = TRUE;
+        return;
+    }
+    event = &nle_dog_trace_events[nle_dog_trace_count_++];
+    (void) memset((genericptr_t) event, 0, sizeof *event);
+    event->kind = (uint32_t) kind;
+    event->entity_id = mon ? (uint32_t) mon->m_id : 0U;
+    event->native_x = mon ? (int32_t) mon->mx : -1;
+    event->native_y = mon ? (int32_t) mon->my : -1;
+    event->arg0 = (int32_t) arg0;
+    event->arg1 = (int32_t) arg1;
+    event->arg2 = (int32_t) arg2;
+    event->result = (int32_t) result;
+    event->moves = (int64_t) moves;
+    event->monstermoves = (int64_t) monstermoves;
+    event->hero_native_x = (int32_t) u.ux;
+    event->hero_native_y = (int32_t) u.uy;
+    if (obj) {
+        event->object_id = (uint32_t) obj->o_id;
+        event->object_type = (int32_t) obj->otyp;
+        event->object_where = (int32_t) obj->where;
+        event->object_quantity = (int64_t) obj->quan;
+    }
+}
+
 STATIC_DCL int NDECL(pet_type);
 
