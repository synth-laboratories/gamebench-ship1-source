 #if (NH_DEVEL_STATUS != NH_STATUS_RELEASED)
     if (x <= 0) {
         impossible("rn2(%d) attempted", x);
         return 0;
     }
-    x = RND(x);
-    return x;
-#else
-    return RND(x);
 #endif
+    result = RND(x);
+    nle_rng_trace_annotate((uintptr_t) __builtin_return_address(0), 1);
+    return result;
 }
 
